# Copy to backend/.env and fill in. The server now refuses to start without JWT_SECRET.

PORT=3001

# REQUIRED. Any long random string. The server exits if this is missing, because the
# old fallback ('super-secret-jwt-key') is public in the repo history and lets anyone
# forge an admin token.
#   generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Master admin. Credentials used to be hardcoded as adminpark/adminpark, which is a
# full-system login published in this repo. Leave MASTER_ADMIN_PASSWORD blank and
# the account is disabled: teachers still sign in with their own teacher_code, but
# nobody can register new teachers, delete a teacher, or run the end-of-term
# document cleanup.
#
# MASTER_ADMIN_PASSWORD works on BOTH login tabs - as the password next to the
# username, and on its own in the Teacher Code field. One account, one secret.
MASTER_ADMIN_USERNAME=adminpark
MASTER_ADMIN_PASSWORD=

# Optional, and only if you want the Teacher Code field to take a different value
# from the password. Unset means it just reuses MASTER_ADMIN_PASSWORD.
MASTER_ADMIN_CODE=
