# Copy to backend/.env and fill in. The server now refuses to start without JWT_SECRET.

PORT=3001

# REQUIRED. Any long random string. The server exits if this is missing, because the
# old fallback ('super-secret-jwt-key') is public in the repo history and lets anyone
# forge an admin token.
#   generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Master admin. Credentials used to be hardcoded as adminpark/adminpark, which is a
# full-system login published in this repo. Set these to re-enable the account:
# leave them blank and the master admin is simply disabled (teachers still log in
# with their teacher_code, but nobody can register new teachers or run the
# end-of-term cleanup).
MASTER_ADMIN_USERNAME=adminpark
MASTER_ADMIN_PASSWORD=
# Optional: lets the master admin sign in through the Teacher Code tab too.
MASTER_ADMIN_CODE=
