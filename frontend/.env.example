# Copy to frontend/.env (Vite only exposes VITE_-prefixed vars to the browser).

VITE_API_URL=https://your-backend-domain.up.railway.app

# Optional TURN relay for voice chat. With STUN only (the default), students behind
# symmetric NAT or a school firewall never connect to each other at all. Add a TURN
# server and those calls start working.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
